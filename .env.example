# Copy to .env and adjust for your machine. Never commit .env.

# Required. The README's Docker command publishes PostgreSQL on port 5433.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/scheduling

# development | production — tracebacks appear in error responses only in development.
ENVIRONMENT=development

PORT=8000

# --- Slots ---
SLOT_GENERATION_DAYS=30

# --- Temporal ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=calendly-tasks
# true | false — false skips all workflow starts (API runs without Temporal).
TEMPORAL_ENABLED=true

# --- Email (defaults point at a local mail catcher such as Mailpit on 1025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Scheduler <noreply@example.com>

# --- Google (leave empty to disable; calendar events are then skipped) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_SENDER_EMAIL=info@example.com